#!/usr/bin/env sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

resolve_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then
    command -v gitleaks
    return 0
  fi

  if [ -x "$HOME/.nix-profile/bin/gitleaks" ]; then
    printf '%s\n' "$HOME/.nix-profile/bin/gitleaks"
    return 0
  fi

  return 1
}

run_gitleaks() {
  if ! gitleaks_bin="$(resolve_gitleaks)"; then
    cat >&2 <<'EOF'
pre-commit: gitleaks is required to scan staged changes for secrets.
Run ./scripts/setup-git-hooks.sh to install gitleaks via Nix profile,
or install gitleaks manually and re-run the commit.
EOF
    exit 1
  fi

  "$gitleaks_bin" git --staged --no-banner --redact --log-level warn
}

if ! run_gitleaks; then
  cat >&2 <<'EOF'
pre-commit: potential secrets detected by gitleaks.
Resolve the findings or explicitly allowlist as appropriate before committing.
EOF
  exit 1
fi
